<Window x:Class="s17o.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="s17o" Height="820" Width="1200" MinWidth="900" MinHeight="600"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="StatusBlock" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左パネル：コントロール ===== -->
        <DockPanel Grid.Column="0" Margin="10">

            <!-- ヘッダー -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="s17o" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="設定" DockPanel.Dock="Right" Click="OnSettingsClick" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- キーワード -->
            <GroupBox DockPanel.Dock="Top" Header="キーワード" Margin="0,0,0,8">
                <StackPanel>
                    <TextBox x:Name="KeywordsBox"
                             AcceptsReturn="True" MinLines="4" MaxLines="8"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="1行に1キーワードです。" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- ステータスブロック -->
            <GroupBox DockPanel.Dock="Top" Header="ブラウザコントロール" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BlockStatus"   Style="{StaticResource StatusBlock}" Margin="0,0,3,0"/>
                        <Border Grid.Column="1" x:Name="BlockTab"      Style="{StaticResource StatusBlock}" Margin="3,0,3,0"/>
                        <Border Grid.Column="2" x:Name="BlockAuto"     Style="{StaticResource StatusBlock}" Margin="3,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BlockProfile"  Style="{StaticResource StatusBlock}" Margin="0,0,3,0"/>
                        <Border Grid.Column="1" x:Name="BlockBaseball" Style="{StaticResource StatusBlock}" Margin="3,0,0,0"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="監視開始" Click="OnStartClick"/>
                        <Button Content="停止"     Click="OnStopClick"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- エラー表示 -->
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                       DockPanel.Dock="Top" Margin="0,4,0,0" Visibility="Collapsed"/>

            <TextBlock DockPanel.Dock="Bottom" Text="© s17o" FontSize="10" Foreground="Gray"
                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </DockPanel>

        <!-- スプリッター -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

        <!-- ===== 右パネル：内蔵ブラウザ ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- アドレスバー -->
            <DockPanel Grid.Row="0" Margin="4,4,4,0">
                <Button Content="←" Width="30" Click="OnBackClick" DockPanel.Dock="Left"/>
                <Button Content="→" Width="30" Click="OnForwardClick" DockPanel.Dock="Left"/>
                <Button Content="↺" Width="30" Click="OnReloadClick" DockPanel.Dock="Left"/>
                <Button Content="移動" Click="OnNavigateClick" DockPanel.Dock="Right"/>
                <TextBox x:Name="AddressBar" KeyDown="OnAddressBarKeyDown" Margin="4,0"/>
            </DockPanel>

            <!-- WebView2 本体 -->
            <wv2:WebView2 x:Name="WebView" Grid.Row="1"
                          Source="about:blank"
                          NavigationStarting="OnNavigationStarting"
                          NavigationCompleted="OnNavigationCompleted"/>
        </Grid>
    </Grid>
</Window>
